rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function studentPath(uid) {
      return /databases/$(database)/documents/students/$(uid);
    }
    function profile() {
      return get(studentPath(request.auth.uid)).data;
    }
    function admin() {
      return signed() && exists(studentPath(request.auth.uid))
        && profile().role == 'admin';
    }
    function staff() {
      return signed() && exists(studentPath(request.auth.uid))
        && profile().role in ['teacher', 'admin'];
    }
    function own(uid) { return signed() && request.auth.uid == uid; }

    // Private student records: owner and administrators only.
    match /students/{uid} {
      allow get: if own(uid) || admin();
      allow list: if admin();
      allow create: if own(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.keys().hasOnly([
          'fullName', 'phone', 'regNo', 'course', 'year', 'gender',
          'email', 'role', 'createdAt'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.regNo is string
        && request.resource.data.course is string
        && request.resource.data.year is string;
      allow update: if (
          own(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.regNo == resource.data.regNo
          && request.resource.data.course == resource.data.course
          && request.resource.data.year == resource.data.year
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'phone', 'gender', 'dob', 'nationality',
            'emergency', 'guardianName', 'bio', 'social'
          ])
        ) || (
          admin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && request.resource.data.role in ['student', 'teacher', 'admin']
        );
      allow delete: if admin();
    }

    // Directory-safe fields only. Do not put phone, email, registration,
    // date-of-birth, or guardian details in this collection.
    match /publicProfiles/{uid} {
      allow read: if signed();
      allow create: if (
          own(uid)
          && request.resource.data.keys().hasOnly([
            'fullName', 'course', 'year', 'bio', 'social'
          ])
          && request.resource.data.fullName == profile().fullName
          && request.resource.data.course == profile().course
          && request.resource.data.year == profile().year
        ) || (
          admin()
          && request.resource.data.keys().hasOnly([
            'fullName', 'course', 'year', 'bio', 'social'
          ])
        );
      allow update: if (
          own(uid)
          && request.resource.data.keys().hasOnly([
            'fullName', 'course', 'year', 'bio', 'social'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'bio', 'social'
          ])
          && request.resource.data.fullName == profile().fullName
        ) || (
          admin()
          && request.resource.data.keys().hasOnly([
            'fullName', 'course', 'year', 'bio', 'social'
          ])
        );
      allow delete: if admin();
    }

    match /modules/{moduleId} {
      allow read: if signed();
      allow create: if staff()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'code', 'name', 'description', 'resource', 'teacherId',
          'teacherName', 'createdAt'
        ]);
      allow update: if admin() || (
        staff()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
      );
      allow delete: if admin() || (
        staff() && resource.data.teacherId == request.auth.uid
      );
    }

    match /moduleEnrollments/{enrollmentId} {
      allow read: if signed() && (
        resource.data.studentId == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || admin()
      );
      allow create: if signed()
        && request.resource.data.studentId == request.auth.uid
        && enrollmentId == request.auth.uid + '_' + request.resource.data.moduleId
        && request.resource.data.keys().hasOnly([
          'studentId', 'moduleId', 'moduleName', 'teacherId',
          'studentName', 'regNo', 'phone', 'year', 'course', 'enrolledAt'
        ])
        && exists(/databases/$(database)/documents/modules/$(request.resource.data.moduleId))
        && get(/databases/$(database)/documents/modules/$(request.resource.data.moduleId)).data.teacherId == request.resource.data.teacherId
        && request.resource.data.studentName == profile().fullName
        && request.resource.data.regNo == profile().regNo
        && request.resource.data.phone == profile().phone
        && request.resource.data.year == profile().year
        && request.resource.data.course == profile().course;
      allow update: if false;
      allow delete: if signed() && (
        resource.data.studentId == request.auth.uid
        || resource.data.teacherId == request.auth.uid
        || admin()
      );
    }

    // Work items are published content, not student records. Signed-in users
    // can read published work; writes are restricted to the owning lecturer/admin.
    match /work/{workId} {
      allow read: if signed();
      allow create: if staff()
        && exists(/databases/$(database)/documents/modules/$(request.resource.data.moduleId))
        && request.resource.data.teacherId == get(/databases/$(database)/documents/modules/$(request.resource.data.moduleId)).data.teacherId
        && (admin() || get(/databases/$(database)/documents/modules/$(request.resource.data.moduleId)).data.teacherId == request.auth.uid)
        && request.resource.data.keys().hasOnly([
          'moduleId', 'moduleName', 'type', 'title', 'date',
          'details', 'link', 'teacherId', 'createdAt'
        ]);
      allow update: if admin() || (
        staff()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId
      );
      allow delete: if admin() || (
        staff() && resource.data.teacherId == request.auth.uid
      );
    }

    // PDF notes: students can read notes only for modules they joined.
    match /notes/{noteId} {
      function enrolled(moduleId) {
        return exists(/databases/$(database)/documents/moduleEnrollments/$(request.auth.uid + '_' + moduleId));
      }
      allow read: if signed() && (
        admin()
        || resource.data.teacherId == request.auth.uid
        || enrolled(resource.data.moduleId)
      );
      allow create: if staff()
        && request.resource.data.keys().hasOnly([
          'moduleId', 'moduleName', 'title', 'fileName', 'storagePath',
          'contentType', 'size', 'teacherId', 'createdAt'
        ])
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.contentType == 'application/pdf'
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 20 * 1024 * 1024
        && request.resource.data.storagePath is string
        && exists(/databases/$(database)/documents/modules/$(request.resource.data.moduleId))
        && (admin() || get(/databases/$(database)/documents/modules/$(request.resource.data.moduleId)).data.teacherId == request.auth.uid);
      allow update: if false;
      allow delete: if admin() || (staff() && resource.data.teacherId == request.auth.uid);
    }

    match /chatRooms/{roomId} {
      allow get: if signed() && (
        roomId == 'general'
        || (resource.data.type == 'course' && resource.data.course == profile().course)
        || (resource.data.type == 'dm'
          && resource.data.participants.hasAny([request.auth.uid]))
      );
      allow list: if false;
      allow create: if signed() && (
        (
          request.resource.data.type == 'course'
          && request.resource.data.course == profile().course
          && request.resource.data.keys().hasOnly(['type', 'course'])
        ) || (
          request.resource.data.type == 'dm'
          && request.resource.data.participants is list
          && request.resource.data.participants.size() == 2
          && request.resource.data.participants.hasAny([request.auth.uid])
          && request.resource.data.participants[0] != request.resource.data.participants[1]
          && roomId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          && request.resource.data.keys().hasOnly(['type', 'participants', 'updatedAt'])
        )
      );
      allow update: if signed() && (
        (
          resource.data.type == 'course'
          && resource.data.course == profile().course
          && request.resource.data.type == resource.data.type
          && request.resource.data.course == resource.data.course
          && request.resource.data.keys().hasOnly(['type', 'course'])
        ) || (
          resource.data.type == 'dm'
          && request.resource.data.type == resource.data.type
          && resource.data.participants.hasAny([request.auth.uid])
          && request.resource.data.participants == resource.data.participants
          && request.resource.data.keys().hasOnly(['type', 'participants', 'updatedAt'])
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        function roomAllowed() {
          return signed() && (
            roomId == 'general'
            || (
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.type == 'course'
              && get(/databases/$(database)/documents/chatRooms/$(roomId)).data.course == profile().course
            )
            || (
              get(/databases/$(database)/documents/chatRooms/$(roomId)).data.type == 'dm'
              && get(/databases/$(database)/documents/chatRooms/$(roomId)).data.participants.hasAny([request.auth.uid])
            )
          );
        }
        allow read: if roomAllowed();
        allow create: if roomAllowed()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName == profile().fullName
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.message.size() <= 1000
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderName', 'message', 'createdAt'
          ]);
        allow update, delete: if false;
      }
    }
  }
}