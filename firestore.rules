rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role; }
    function staff() { return signed() && role() in ['teacher', 'admin']; }

    match /students/{id} {
      allow read: if signed();
      allow create: if request.auth.uid == id && request.resource.data.role == 'student';
      allow update: if request.auth.uid == id && request.resource.data.role == resource.data.role;
    }
    match /modules/{id} {
      allow read: if signed();
      allow create: if staff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if staff() && resource.data.teacherId == request.auth.uid;
    }
    match /moduleEnrollments/{id} {
      allow read: if signed() && (resource.data.studentId == request.auth.uid || resource.data.teacherId == request.auth.uid);
      allow create: if signed() && request.resource.data.studentId == request.auth.uid;
      allow delete: if signed() && resource.data.studentId == request.auth.uid;
    }
    match /work/{id} {
      allow read: if signed();
      allow create: if staff() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if staff() && resource.data.teacherId == request.auth.uid;
    }
    match /chatRooms/{room}/messages/{msg} {
      allow read: if signed() && (room == 'general' || room.matches('course_.*') || room.matches('.*' + request.auth.uid + '.*'));
      allow create: if signed() && request.resource.data.senderId == request.auth.uid
        && (room == 'general' || room.matches('course_.*') || room.matches('.*' + request.auth.uid + '.*'));
    }
  }
}
